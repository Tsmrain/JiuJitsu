@startuml
skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam packageStyle rectangle

actor "Usuario\n(Alumno / Profesor / Admin)" as user

rectangle "Sistema de Análisis Biomecánico" {
  usecase "UC-01: Autenticarse en la Plataforma" as UC01
  usecase "Validar Credenciales" as UC01_1
  usecase "Generar Token de Sesión" as UC01_2
  usecase "Recuperar Perfil de Usuario" as UC01_3
}

user --> UC01
UC01 ..> UC01_1 : <<include>>
UC01 ..> UC01_2 : <<include>>
UC01 ..> UC01_3 : <<include>>

@enduml