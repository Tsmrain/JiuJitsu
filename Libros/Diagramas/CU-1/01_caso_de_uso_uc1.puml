@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Alumno" as Alumno
actor "Profesor" as Profesor
actor "Administrador" as Admin

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC1: Autenticarse\nen la Plataforma" as UC1
    
    usecase "Validar Credenciales\ncontra PostgreSQL" as UC1_Validar
    usecase "Generar JWT\nFirmado con HS256" as UC1_JWT
    usecase "Recuperar Perfil\ndel Usuario" as UC1_Perfil
    usecase "Redirigir al Panel\nsegún Rol" as UC1_Redirigir
}

Alumno --> UC1
Profesor --> UC1
Admin --> UC1

UC1 ..> UC1_Validar : <<include>>
UC1 ..> UC1_JWT : <<include>>
UC1 ..> UC1_Perfil : <<include>>
UC1 ..> UC1_Redirigir : <<include>>

note right of UC1
  **Precondición:** Usuario no autenticado.
  **Postcondición:** JWT válido por 24h
  con claims uid, role, email, sucursal_id.
end note

@enduml