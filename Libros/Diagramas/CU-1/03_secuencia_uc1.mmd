sequenceDiagram
    autonumber
    actor Usuario
    participant Interfaz as InterfazAutenticacion
    participant Sistema as SistemaAutenticacion
    participant BD as BaseDeDatos
    participant Generador as GeneradorTokens
    
    Usuario->>Interfaz: solicitarAutenticacion(identificador, contraseña)
    Interfaz->>Interfaz: validarFormatoCredenciales()
    
    alt Credenciales con formato válido
        Interfaz->>Sistema: autenticarUsuario(identificador, contraseña)
        Sistema->>BD: buscarUsuarioPorIdentificador(identificador)
        
        alt Usuario encontrado
            BD-->>Sistema: usuarioEncontrado
            Sistema->>BD: verificarContraseña(contraseña, contraseñaHasheada)
            
            alt Contraseña correcta
                BD-->>Sistema: contraseñaValida
                Sistema->>Generador: generarToken(usuarioId, rol, email, sucursalId)
                Generador-->>Sistema: tokenFirmado
                Sistema->>BD: recuperarPerfilCompleto(usuarioId)
                BD-->>Sistema: perfilUsuario
                
                Sistema-->>Interfaz: TokenAutenticacion(token, usuario, sucursal)
                Interfaz-->>Usuario: confirmacionAutenticacion(datosUsuario)
                Interfaz->>Interfaz: redirigirSegunRol(usuario)
                
            else Contraseña incorrecta
                BD-->>Sistema: contraseñaInvalida
                Sistema-->>Interfaz: errorCredencialesIncorrectas
                Interfaz-->>Usuario: mensajeErrorGenerico
            end
            
        else Usuario no encontrado
            BD-->>Sistema: usuarioNoExiste
            Sistema-->>Interfaz: errorCredencialesIncorrectas
            Interfaz-->>Usuario: mensajeErrorGenerico
        end
        
    else Credenciales con formato inválido
        Interfaz-->>Usuario: mensajeErrorFormato
    end