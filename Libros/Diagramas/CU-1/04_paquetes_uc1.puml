@startuml
skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam packageStyle package
skinparam roundCorner 10

package "Capa de Presentación\n(Frontend React 19)" #EBF8FF {
    [LoginModal.jsx] as UI_Login
    [AuthContext.jsx] as UI_Auth
}

package "Capa de Aplicación\n(FastAPI + PostgREST)" #E6FFFA {
    [auth_routes.py\n(AuthController)] as API_Auth
    [PostgrestClient] as API_DB
}

package "Capa de Dominio\n(Conceptos Puros)" #FAF5FF {
    [Usuario\n(Entidad Conceptual)] as DOM_User
    [Sesión JWT\n(Claims)] as DOM_Session
}

package "Capa de Infraestructura\n(PostgreSQL + pgcrypto)" #FFF5F5 {
    [RPC authenticate()\n(SECURITY DEFINER)] as INF_RPC
    [Tabla usuarios\n(password_hash)] as INF_TABLE
    [JWT_SECRET_KEY\n(Vars de Entorno)] as INF_CONFIG
}

' Relaciones y Dependencias
UI_Login --> API_Auth : HTTP POST /auth/login
UI_Auth ..> UI_Login : Gestiona estado sesión
API_Auth --> API_DB : Llama RPC via HTTP
API_DB --> INF_RPC : Ejecuta función SQL
INF_RPC --> INF_TABLE : Verifica bcrypt
INF_RPC ..> DOM_Session : Retorna payload firmado
API_Auth --> DOM_Session : Firma JWT HS256
DOM_Session ..> DOM_User : Contiene identidad


@enduml