@startuml
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam packageStyle rectangle

actor "Alumno" as alumno

rectangle "Sistema de Análisis Biomecánico" {
  usecase "UC-02: Analizar Técnica y Generar Feedback" as UC02
  usecase "Seleccionar Profesor y Técnica" as UC02_1
  usecase "Validar Contenido del Video" as UC02_2
  usecase "Extraer Puntos Articulares" as UC02_3
  usecase "Calcular Similitud Biomecánica" as UC02_4
  usecase "Recuperar Doctrina Relevante" as UC02_5
  usecase "Generar Feedback Pedagógico" as UC02_6
  usecase "Registrar Evaluación" as UC02_7
}

alumno --> UC02
UC02 ..> UC02_1 : <<include>>
UC02 ..> UC02_2 : <<include>>
UC02 ..> UC02_3 : <<include>>
UC02 ..> UC02_4 : <<include>>
UC02 ..> UC02_5 : <<extend>>\n(si similitud < umbral)
UC02 ..> UC02_6 : <<extend>>\n(si similitud < umbral)
UC02 ..> UC02_7 : <<include>>

@enduml