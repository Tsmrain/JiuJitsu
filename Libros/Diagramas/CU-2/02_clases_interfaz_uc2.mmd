classDiagram
    direction LR

    class VideoUploadView {
        <<boundary>>
        +profesorId: UUID
        +tecnicaId: UUID
        +videoArchivo: File
        +idiomaPreferido: String
        +onVideoSelect(archivo: File): void
        +mostrarProgresoAnalisis(): void
        +solicitarAnalisis(): void
    }

    class EvaluationController {
        <<controller>>
        +analizarVideo(solicitud: SolicitudAnalisisDTO): EvaluacionIniciadaDTO
        +consultarEvaluacion(evaluacionId: UUID): ResultadoEvaluacionDTO
    }

    class SolicitudAnalisisDTO {
        <<DTO>>
        +profesorId: UUID
        +tecnicaId: UUID
        +videoArchivo: File
        +idiomaPreferido: String
    }

    class EvaluacionIniciadaDTO {
        <<DTO>>
        +evaluacionId: UUID
        +estado: String
    }

    class ResultadoEvaluacionDTO {
        <<DTO>>
        +evaluacionId: UUID
        +similitud: Float
        +feedbackTexto: String
        +estado: EstadoEnum
        +urlVideoReferencia: String
        +nombreProfesor: String
    }

    class EstadoEnum {
        <<enumeration>>
        PROCESANDO
        COMPLETADO
        ERROR_PROCESAMIENTO
        INVALIDA
    }

    VideoUploadView ..> EvaluationController : invoca
    VideoUploadView ..> SolicitudAnalisisDTO : construye
    EvaluationController ..> SolicitudAnalisisDTO : recibe
    EvaluationController ..> EvaluacionIniciadaDTO : retorna
    EvaluationController ..> ResultadoEvaluacionDTO : retorna
    ResultadoEvaluacionDTO --> EstadoEnum : tiene