sequenceDiagram
    autonumber
    actor Alumno
    participant UI as VideoUploadView (React)
    participant Ctrl as EvaluationController (FastAPI)
    participant Facade as IntelligenceAnalysisFacade
    participant Colab as ColabWorker (YOLO26)
    participant Qdrant as QdrantVectorAdapter
    participant Gemini as GeminiApiAdapter
    participant DB as PostgresDB

    Alumno->>UI: Selecciona profesor, técnica y adjunta video
    UI->>Ctrl: POST /evaluaciones/analizar (Multipart DTO)
    
    Ctrl->>Gemini: validarEsJiuJitsu(video)
    alt Video inválido / Spam
        Gemini-->>Ctrl: False
        Ctrl-->>UI: HTTP 422 (Video no corresponde a BJJ)
        UI-->>Alumno: Muestra error de contenido
    else Video válido
        Gemini-->>Ctrl: True
        Ctrl->>DB: create_evaluacion(id, alumno_id, estado='procesando')
        DB-->>Ctrl: OK
        Ctrl-->>UI: HTTP 200 {evaluacion_id, estado='procesando'}
        UI-->>Alumno: Muestra barra de progreso / Polling activo

        Note over Ctrl,Facade: Inferencia asíncrona (Worker / Background)
        Ctrl->>Facade: ejecutarAnalisisCompleto(video, tecnicaId, profesorId)
        
        Facade->>Colab: extraerKeypoints(video)
        Colab-->>Facade: esqueletoAlumno (133 keypoints/frame)
        
        Facade->>Qdrant: buscarMaximaDiferencia(esqueletoAlumno, tecnicaId)
        Qdrant-->>Facade: {score, frameCritico, discrepancias}
        
        alt Similitud >= 85.0 (Técnica Correcta)
            Facade->>Facade: feedback = "¡Técnica ejecutada correctamente!"
        else Similitud < 85.0 (Requiere Corrección)
            Facade->>Qdrant: recuperarContextoRag(vectorTexto, tecnicaId)
            Qdrant-->>Facade: teoriaDoctrinal
            Facade->>Gemini: generarTextoFeedback(prompt, frameCritico)
            Gemini-->>Facade: feedbackPedagogico
        end
        
        Facade->>DB: worker_update_result(evaluacion_id, similitud, feedback, 'completado')

        loop Polling (cada 3s)
            UI->>Ctrl: GET /evaluaciones/{id}
            Ctrl->>DB: get_evaluacion_by_id(id)
            DB-->>Ctrl: {estado, similitud, feedback, videoRefUrl}
            Ctrl-->>UI: ResultadoEvaluacionDTO
        end

        UI-->>Alumno: Muestra reporte completo con video de referencia y feedback
    end