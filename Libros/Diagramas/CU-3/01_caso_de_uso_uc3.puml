@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Profesor" as Prof
actor "Google Colab GPU" as Colab <<Worker AI>>

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC3: Gestionar Técnicas\ny Videos de Referencia" as UC3
    
    usecase "Listar Técnicas\ndel Profesor" as UC3_List
    usecase "Crear / Editar\nTécnica" as UC3_Create
    usecase "Cargar Video\nde Referencia" as UC3_Video
    usecase "Eliminar\nTécnica" as UC3_Del
    usecase "Extraer Keypoints\nde Referencia" as UC3_Extract
}

Prof --> UC3
UC3 ..> UC3_List : <<include>>
UC3 ..> UC3_Create : <<include>>
UC3 ..> UC3_Video : <<include>>
UC3 ..> UC3_Del : <<extend>>
UC3_Video ..> UC3_Extract : <<include>>

UC3_Extract ..> Colab : <<invoca>>

@enduml