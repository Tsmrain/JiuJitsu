@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Profesor" as Prof
actor "Google Colab GPU" as Colab <<Qwen3-VL Embeddings>>
actor "Qdrant Vector DB" as Qdrant <<Vector Engine>>
actor "PostgreSQL" as PG <<Relational DB>>

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC4: Gestionar Teoría RAG" as UC4
    
    usecase "Ingresar Texto\ndel Manual" as UC4_Input
    usecase "Vectorizar Chunks\ncon Qwen" as UC4_Embed
    usecase "Persistir en\nQdrant + Postgres" as UC4_Persist
    usecase "Visualizar Chunks\nSubidos" as UC4_View
    usecase "Eliminar Toda\nla Teoría" as UC4_Del
}

Prof --> UC4
UC4 ..> UC4_Input : <<include>>
UC4 ..> UC4_Embed : <<include>>
UC4 ..> UC4_Persist : <<include>>
UC4 ..> UC4_View : <<extend>>
UC4 ..> UC4_Del : <<extend>>

UC4_Embed ..> Colab : <<invoca>>
UC4_Persist ..> Qdrant : <<almacena>>
UC4_Persist ..> PG : <<almacena>>
UC4_Del ..> Qdrant : <<borra>>
UC4_Del ..> PG : <<borra>>

@enduml