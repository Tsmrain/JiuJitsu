classDiagram
    direction LR

    class Profesor {
        <<Actor>>
        +userId: UUID
        +sucursalId: UUID
        +token: String
    }

    class TheoryManagerModal {
        <<Boundary - React>>
        +chunks: List~TheoryChunkDTO~
        +loading: Boolean
        +deleting: Boolean
        +error: String
        +fetchChunks(): void
        +handleDeleteAll(): void
        +formatFecha(iso): String
        +render(): JSX.Element
    }

    class KnowledgeController {
        <<Boundary - FastAPI>>
        +POST_conocimiento_teoria(payload) IngestionResponse
        +GET_conocimiento_teoria(tecnica_id, solo_mios) List~TheoryChunkDTO~
        +DELETE_conocimiento_teoria(tecnica_id) DeleteResponse
    }

    class IngestKnowledgeUseCase {
        <<UseCase>>
        +execute(tecnicaId, contenidoTexto, profesorId, sucursalId) IngestionResponse
    }

    class ListTheoryUseCase {
        <<UseCase>>
        +execute(tecnicaId, profesorId) List~TheoryChunkDTO~
    }

    class DeleteTheoryUseCase {
        <<UseCase>>
        +execute(tecnicaId, profesorId) DeleteResponse
    }

    class QdrantRAGAdapter {
        <<Adapter>>
        +ingestar_desde_respuesta(data, tecnica_id) dict
        +eliminar_puntos(point_ids) int
        +recuperar_contexto(query_embedding, tecnica_id, top_k) list
    }

    class IngestionResponse {
        <<DTO - Pydantic>>
        +status: String
        +chunks_procesados: Int
    }

    Profesor --> TheoryManagerModal
    TheoryManagerModal --> KnowledgeController : GET/DELETE
    KnowledgeController --> IngestKnowledgeUseCase : POST
    KnowledgeController --> ListTheoryUseCase : GET
    KnowledgeController --> DeleteTheoryUseCase : DELETE
    IngestKnowledgeUseCase --> QdrantRAGAdapter
    DeleteTheoryUseCase --> QdrantRAGAdapter
    IngestKnowledgeUseCase --> IngestionResponse