@startuml
!theme plain
skinparam packageStyle rectangle

package "Capa de Presentación (React 19)" as UI {
    [TheoryManagerModal.jsx] as TMM
    [ProfesorTecnicas.jsx] as PT
}

package "Capa de Aplicación (FastAPI)" as App {
    [routes.py (KnowledgeController)] as Routes
    [IngestKnowledgeUseCase] as IUC
    [ListTheoryUseCase] as LUC
    [DeleteTheoryUseCase] as DUC
    [IngestionRequest / IngestionResponse DTOs] as DTOs
}

package "Capa de Dominio (Conceptual)" as Domain {
    [TeoriaReferencia (conceptual)] as TR
    [Chunk (conceptual)] as Chunk
    [VectorEmbedding (conceptual)] as Vec
}

package "Capa de Infraestructura" as Infra {
    [QdrantRAGAdapter] as Qdrant
    [PostgrestClient] as PgClient
    [QwenEmbeddingAdapter (Colab)] as Qwen
}

package "Servicios Externos" as Ext {
    [Google Colab GPU (Qwen3-VL)] as Colab
    [Qdrant Vector DB] as QdrantDB
    [PostgreSQL + PostgREST] as PG
}

TMM --> Routes : GET/DELETE
PT --> Routes : POST
Routes --> IUC
Routes --> LUC
Routes --> DUC
IUC --> DTOs
IUC --> Qwen
IUC --> Qdrant
IUC --> PgClient
DUC --> Qdrant
DUC --> PgClient
Qwen --> Colab : /embed_text
Qdrant --> QdrantDB : upsert / delete
PgClient --> PG : RPC

note right of IUC
  **Pipeline de ingestión:**
  1. POST /embed_text (Colab Qwen)
  2. upsert Qdrant (rag_knowledge)
  3. RPC admin_save_teoria_chunk (Postgres)
end note

@enduml