@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Profesor" as Prof

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC5: Visualizar Progreso\nde Alumnos" as UC5
    
    usecase "Listar Alumnos\nde la Sucursal" as UC5_List
    usecase "Cargar Historial\nde Evaluaciones" as UC5_Hist
    usecase "Mostrar Indicador\nde Color por Score" as UC5_Color
    usecase "Ver Detalle de\nKeypoints y Feedback" as UC5_Detail
}

Prof --> UC5
UC5 ..> UC5_List : <<include>>
UC5 ..> UC5_Hist : <<include>>
UC5 ..> UC5_Color : <<include>>
UC5 ..> UC5_Detail : <<extend>>

@enduml