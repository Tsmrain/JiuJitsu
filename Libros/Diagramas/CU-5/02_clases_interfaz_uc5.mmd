classDiagram
    direction LR

    class Profesor {
        <<Actor>>
        +userId: UUID
        +sucursalId: UUID
        +token: String
    }

    class ProfesorTecnicas {
        <<Boundary - React>>
        +activeTab: String
        +alumnos: List~LoginResponse~
        +evaluacionesPorAlumno: Map~UUID,List~
        +selectedAlumnoDetail: Object
        +fetchAlumnos(): void
        +fetchEvaluacionesAlumno(alumnoId): void
        +getScoreColor(score): String
        +render(): JSX.Element
    }

    class StudentDetailModal {
        <<Boundary - React>>
        +alumno: Object
        +evalItem: Object
        +renderKeypointsDetail(): JSX.Element
        +renderFeedback(): JSX.Element
    }

    class ProgressController {
        <<Boundary - FastAPI>>
        +listar_alumnos(p_sucursal_id, auth) List~LoginResponse~
        +listar_evaluaciones_alumno(alumno_id, auth) List~EvaluacionDTO~
    }

    class PostgrestClient {
        <<Adapter>>
        +rpc(function_name, params, token) dict
    }

    Profesor --> ProfesorTecnicas
    ProfesorTecnicas *-- StudentDetailModal : contiene
    ProfesorTecnicas --> ProgressController : HTTP GET
    ProgressController --> PostgrestClient : rpc()