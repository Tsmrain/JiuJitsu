sequenceDiagram
    autonumber
    actor P as Profesor
    participant UI as ProfesorTecnicas<br/>(React)
    participant PC as ProgressController<br/>(FastAPI)
    participant DB as PostgrestClient
    participant PG as PostgreSQL

    P->>UI: Accede a pestaña "Progreso de Mis Alumnos"
    UI->>PC: GET /api/v1/auth/alumnos?p_sucursal_id={id}
    PC->>PC: require_auth (verifica JWT)
    PC->>DB: rpc("admin_list_alumnos", {p_sucursal_id})
    DB->>PG: SELECT * FROM usuarios WHERE rol='alumno' AND sucursal_id = ...
    PG-->>DB: [{id, nombre_completo, username, avatar_url, sucursal_nombre}]
    DB-->>PC: alumnos
    PC-->>UI: HTTP 200 List~LoginResponse~
    UI-->>P: Renderiza lista de alumnos
    
    loop Por cada alumno
        UI->>PC: GET /api/v1/auth/alumnos/{id}/evaluaciones
        PC->>DB: rpc("admin_list_evaluaciones_alumno", {p_alumno_id})
        DB->>PG: SELECT e.*, t.nombre FROM evaluaciones_alumnos e LEFT JOIN tecnicas t WHERE alumno_id = ... ORDER BY fecha_evaluacion DESC LIMIT 20
        PG-->>DB: [{id, tecnica_nombre, porcentaje_similitud, estado, feedback_gemini_es, fecha_evaluacion}]
        DB-->>PC: evaluaciones
        PC-->>UI: HTTP 200 List~EvaluacionDTO~
        UI->>UI: setEvaluacionesPorAlumno({...prev, [alumnoId]: data})
        UI->>UI: getScoreColor(similitud) → verde/amarillo/rojo
    end
    
    UI-->>P: Renderiza cards con score, barra de progreso y feedback
    
    P->>UI: Clic "Ver Detalle Keypoints"
    UI->>UI: setSelectedAlumnoDetail({alumno, evalItem})
    UI-->>P: Modal con score, estado, feedback de Gemini