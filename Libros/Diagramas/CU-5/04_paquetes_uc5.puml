@startuml
!theme plain
skinparam packageStyle rectangle

package "Capa de Presentación (React 19)" as UI {
    [ProfesorTecnicas.jsx] as PT
    [StudentDetailModal] as SDM
    [ProgressBar (inline)] as PB
}

package "Capa de Aplicación (FastAPI)" as App {
    [auth_routes.py (ProgressController)] as Routes
    [require_auth / require_staff (guards)] as Guards
}

package "Capa de Dominio (Conceptual)" as Domain {
    [Alumno (conceptual)] as Alumno
    [Evaluacion (conceptual)] as Evaluacion
    [Tecnica (conceptual)] as Tecnica
}

package "Capa de Infraestructura" as Infra {
    [PostgrestClient] as PgClient
    [PostgreSQL + PostgREST + RLS] as PG
}

PT --> Routes : GET /alumnos
PT --> Routes : GET /alumnos/{id}/evaluaciones
PT *-- SDM : modal
PT *-- PB : barra de progreso
Routes --> Guards : valida rol y sucursal
Routes --> PgClient : rpc()
PgClient --> PG : HTTP REST + RLS

note right of Routes
  **RPCs utilizados:**
  - admin_list_alumnos(p_sucursal_id)
  - admin_list_evaluaciones_alumno(p_alumno_id)
end note

@enduml