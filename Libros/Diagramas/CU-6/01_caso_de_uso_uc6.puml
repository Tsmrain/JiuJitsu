@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Administrador" as Admin
actor "OpenStreetMap / Leaflet" as OSM <<Map Service>>
actor "Nominatim API" as NOM <<Geocoding Service>>
actor "Google Maps" as GMaps <<URL Scraper>>

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC6: Gestionar Sucursales\ny Coordenadas Geográficas" as UC6
    
    usecase "Crear / Editar\nSucursal" as UC6_CRUD
    usecase "Capturar Coordenadas\nen Mapa Interactivo" as UC6_Map
    usecase "Pegar Enlace de\nGoogle Maps" as UC6_GMap
    usecase "Geocodificación\nInversa (Nominatim)" as UC6_Geo
    usecase "Generar Plus Code\npara Zonas sin Calle" as UC6_Plus
    usecase "Eliminar Sucursal\n(si no tiene usuarios)" as UC6_Del
}

Admin --> UC6
UC6 ..> UC6_CRUD : <<include>>
UC6 ..> UC6_Map : <<include>>
UC6 ..> UC6_GMap : <<extend>>
UC6 ..> UC6_Geo : <<include>>
UC6 ..> UC6_Plus : <<extend>>
UC6 ..> UC6_Del : <<extend>>

UC6_Map ..> OSM : <<renderiza>>
UC6_Geo ..> NOM : <<invoca>>
UC6_GMap ..> GMaps : <<parsea>>

@enduml