@startuml
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Administrador" as Admin

rectangle "Sistema Corpo e Mente Biomechanics AI" {
    usecase "UC7: Administrar Usuarios\ne Impersonificación" as UC7
    
    usecase "Listar y Filtrar\nUsuarios" as UC7_List
    usecase "Actualizar\nUsuario" as UC7_Update
    usecase "Impersonificar Usuario\nNo-Admin" as UC7_Imp
    usecase "Mostrar Banner\nPersistente" as UC7_Banner
    usecase "Restaurar Sesión\nOriginal" as UC7_Rev
    usecase "Bloquear Impersonificación\nde Otro Admin" as UC7_Block
}

Admin --> UC7
UC7 ..> UC7_List : <<include>>
UC7 ..> UC7_Update : <<include>>
UC7 ..> UC7_Imp : <<include>>
UC7 ..> UC7_Banner : <<include>>
UC7 ..> UC7_Rev : <<include>>
UC7 ..> UC7_Block : <<extend>>

@enduml