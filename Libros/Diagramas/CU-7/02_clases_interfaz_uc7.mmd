classDiagram
    direction LR

    class Admin {
        <<Actor>>
        +userId: UUID
        +token: String
        +rol: "admin"
    }

    class AdminSucursales {
        <<Boundary - React>>
        +activeTab: "usuarios"
        +usuarios: List~LoginResponse~
        +loadingUsuarios: Boolean
        +fetchUsuarios(): void
        +handleImpersonate(targetUserId): void
        +render(): JSX.Element
    }

    class ImpersonationBanner {
        <<Boundary - React>>
        +impersonatedUserName: String
        +impersonatedRole: String
        +originalAdminUser: Object
        +onRevertSession(): void
        +render(): JSX.Element
    }

    class AdminUserController {
        <<Boundary - FastAPI>>
        +listar_usuarios(auth) List~LoginResponse~
        +update_usuario(user_id, req, auth) LoginResponse
        +impersonate_user(user_id, auth) LoginResponse
    }

    class JWTService {
        <<Service>>
        +_sign_token(payload) String
        +_decode_jwt(authorization) dict
        +require_admin(authorization) dict
    }

    class LoginResponse {
        <<DTO - Pydantic>>
        +token: String
        +user_id: UUID
        +nombre_completo: String
        +username: String
        +email: String
        +rol: String
        +sucursal_id: UUID
        +sucursal_nombre: String
    }

    Admin --> AdminSucursales
    Admin --> ImpersonationBanner
    AdminSucursales --> AdminUserController : HTTP GET/PUT/POST
    AdminUserController --> JWTService : firma tokens
    AdminUserController --> LoginResponse : retorna
    AdminSucursales --> LoginResponse : consume
    ImpersonationBanner --> AdminSucursales : notifica