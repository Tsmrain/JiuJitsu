@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam dpi 300

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontStyle bold
    FontSize 13
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #94A3B8
    BorderThickness 1.0
    FontColor #1E293B
    FontStyle bold
    FontSize 11
}

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #1E3A8A
    FontColor #0F172A
    FontSize 11
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FEF2F2
    BorderColor #D01118
    BorderThickness 1.2
    FontColor #1E293B
    FontSize 11
    ArrowColor #475569
    ArrowThickness 1.0
}

left to right direction

actor "Alumno" as alumno <<Rol>>
actor "Profesor" as profesor <<Rol>>

rectangle "Sistema Corpo e Mente Biomechanics AI" as sistema {
    usecase "UC1: Autenticarse\nen la Plataforma" as UC1
    
    package "Módulo de Práctica" {
        usecase "UC2: Analizar Técnica y\nGenerar Feedback Biomecánico" as UC2
    }
    
    package "Módulo Pedagógico" {
        usecase "UC3: Gestionar Técnicas y\nVideos de Referencia" as UC3
        usecase "UC4: Gestionar Teoría RAG\n(Manuales Doctrinales)" as UC4
        usecase "UC5: Visualizar Progreso\nde Alumnos" as UC5
    }
    
    package "Módulo Administrativo" {
        usecase "UC6: Gestionar Sucursales y\nCoordenadas Geográficas" as UC6
        usecase "UC7: Administrar Usuarios e\nImpersonificación" as UC7
    }
}

actor "Administrador" as admin <<Rol>>

alumno --> UC1
alumno --> UC2

profesor --> UC1
profesor --> UC3
profesor --> UC4
profesor --> UC5

UC1 <-- admin
UC6 <-- admin
UC7 <-- admin

@enduml
