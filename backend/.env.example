# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - CORPO E MENTE BJJ
# Hardening de Producción (Metodología Craig Larman)
# ==============================================================================

# Entorno: 'development' o 'production'
ENVIRONMENT="production"
DEBUG=false

# Claves Criptográficas de Alta Entropía
# IMPORTANTE: En producción, generar una cadena aleatoria de al menos 64 caracteres
# usando python -c "import secrets; print(secrets.token_hex(32))"
POSTGREST_JWT_SECRET="GENERA_AQUI_UN_SECRETO_HEX_DE_MINIMO_64_CARACTERES"
JWT_SECRET_KEY="GENERA_AQUI_UN_SECRETO_HEX_DE_MINIMO_64_CARACTERES"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24

# Token Secreto para Worker Asíncrono de Inferencia
# Generar con python -c "import secrets; print(secrets.token_hex(24))"
WORKER_SERVICE_TOKEN="GENERA_AQUI_UN_TOKEN_SECRETO_PARA_EL_WORKER"

# Infraestructura Vectorial y Persistencia
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="vectores_poses_jiujitsu"
QDRANT_RAG_COLLECTION="rag_knowledge"

POSTGREST_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6379/0"

# CORS Restringido (Dominios e IPs autorizados separados por comas)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:4173"

# Inferencia de IA
USE_LOCAL_QWEN=true
LOCAL_QWEN_MODEL="mlx-community/Qwen3-VL-Embedding-2B-8bit"
COLAB_TUNNEL_URL=""
