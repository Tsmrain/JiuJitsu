sequenceDiagram
    autonumber
    actor U as Usuario
    participant B1 as «Boundary» UI Acceso
    participant C1 as «Control» Controlador de Acceso
    participant E1 as «Entity» Usuario
    participant E2 as «Entity» Sesión

    U->>B1: ingresarCredenciales(identificador, clave)
    B1->>C1: solicitarAutenticacion(identificador, clave)
    C1->>C1: verificarLimiteDeIntentos(identificador)
    alt Límite de intentos superado
        C1-->>B1: bloqueoTemporal()
        B1-->>U: informarEsperaDeSeguridad()
    else Dentro del límite permitido
        C1->>E1: validarCredenciales(identificador, clave)
        alt Credenciales válidas
            E1-->>C1: identidadVerificada(usuario)
            C1->>E2: registrarSesionActiva(usuario)
            E2-->>C1: sesionIniciada
            C1-->>B1: accesoAutenticado(sesionIniciada)
            B1-->>U: confirmarIngresoYEvaluarPerfil()
        else Credenciales incorrectas
            E1-->>C1: credencialesInvalidas
            C1-->>B1: notificarErrorDeAcceso()
            B1-->>U: solicitarNuevasCredenciales()
        end
    end
