sequenceDiagram
    autonumber
    actor U as Usuario
    participant B1 as «Boundary» UI Portal Principal
    participant C1 as «Control» Controlador de Roles
    participant C2 as «Control» Controlador de Mensualidad
    participant E1 as «Entity» Usuario
    participant E2 as «Entity» Sucursal
    participant E3 as «Entity» Mensualidad

    U->>B1: solicitarAccesoAFunciones()
    B1->>C1: consultarRolYSucursal(usuario)
    C1->>E1: obtenerPerfilYSede(usuario)
    E1-->>C1: rolAsignado, sucursal
    C1->>E2: confirmarSedeActiva(sucursal)
    E2-->>C1: datosSucursal
    alt Perfil es Alumno
        B1->>C2: verificarMensualidad(usuario)
        C2->>E3: consultarEstadoYFechaVencimiento(usuario)
        E3-->>C2: estadoMensualidad
        alt Mensualidad vigente
            C2-->>B1: accesoEvaluativoHabilitado()
            B1-->>U: habilitarModulosDeAlumno()
        else Mensualidad pendiente o vencida
            C2-->>B1: restriccionPorMensualidad()
            B1-->>U: habilitarSoloBibliotecaYProgreso()
        end
    else Perfil es Profesor o Dueño
        C1-->>B1: permisosDocentesOAdministrativos(rolAsignado)
        B1-->>U: habilitarModulosSegunRol(rolAsignado)
    end
