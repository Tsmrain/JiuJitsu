@startuml
title Diagrama de Secuencia de Análisis (ECB) — UC-02: Registrar Nuevo Usuario
autonumber
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Solicitante" as U
boundary "PantallaDeRegistro" as B1
control "CoordinadorDeRegistro" as C1
entity "Sucursal" as E1
entity "Usuario" as E2
entity "SesiónDeUsuario" as E3

U -> B1 : solicitarAltaDeCuenta()
B1 -> C1 : consultarSedesDisponibles()
C1 -> E1 : obtenerDirectorioDeSedes()
E1 --> C1 : listaDeSucursales
C1 --> B1 : sedesDisponibles
B1 --> U : presentarFormularioDeRegistro(sedesDisponibles)
U -> B1 : enviarDatosDeRegistro(nombreCompleto, identificador, correo, clave, rol, sede)
B1 -> C1 : registrarNuevoUsuario(datosDeRegistro)
C1 -> E2 : validarFormatoYUnicidad(identificador, correo)
E2 --> C1 : identificadorDisponible
C1 -> E1 : confirmarSedeAdscrita(sede)
E1 --> C1 : sedeConfirmada
C1 -> E2 : crearPerfilConEstadoInicial(datosDeRegistro, sedeConfirmada)
E2 --> C1 : usuarioRegistrado
C1 -> E3 : iniciarSesiónInicial(usuarioRegistrado, rol, sedeConfirmada)
E3 --> C1 : sesiónActiva
C1 --> B1 : registroExitoso(sesiónActiva, perfil)
B1 --> U : presentarEntornoInicial(rol, sedeConfirmada)
@enduml
