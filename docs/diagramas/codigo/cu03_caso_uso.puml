@startuml
left to right direction
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Alumno" as AL
actor "Servicio de Visión\npor Computadora" as SVC

rectangle "Sistema Corpo e Mente - Análisis Biomecánico de Técnica" {
    usecase "UC-03: Analizar Técnica" as UC03
    usecase "Verificar Vigencia de\nPase de Tatami" as UC03_Pase
    usecase "Verificar Elegibilidad\nde la Ejecución" as UC03_Elig
    usecase "Confirmar Practicante\nen Escena Inicial" as UC03_Pers
    usecase "Reconocer Postura Corporal\ndel Practicante" as UC03_Post
    usecase "Comparar Posturas contra\nPatrón del Profesor" as UC03_Comp
    usecase "Identificar Similitud y\nFotograma Crítico" as UC03_Crit
    usecase "UC-04: Generar Feedback\nBiomecánico" as UC04_Ref
}

AL --> UC03
UC03 ..> UC03_Pase : <<include>>
UC03 ..> UC03_Elig : <<include>>
UC03 ..> UC03_Pers : <<include>>
UC03 ..> UC03_Post : <<include>>
UC03 ..> UC03_Comp : <<include>>
UC03 ..> UC03_Crit : <<include>>
UC03 ..> UC04_Ref : <<extend>>\n(Diagnóstico Pedagógico)

UC03_Elig --> SVC
UC03_Pers --> SVC
UC03_Post --> SVC
@enduml
