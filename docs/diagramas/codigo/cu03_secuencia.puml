@startuml
title Diagrama de Secuencia de Análisis (ECB) — UC-03: Analizar Técnica
autonumber
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Alumno" as AL
boundary "PantallaDeEvaluación" as B1
control "CoordinadorDeAnálisisTécnico" as C1
entity "Usuario" as E1
entity "PatrónDeReferencia" as E2
entity "Evaluación" as E3

AL -> B1 : solicitarEvaluación(profesor, técnica, video)
B1 -> C1 : validarMembresíaYElegibilidad(alumno, video)
C1 -> E1 : verificarPaseDeTatamiVigente(alumno)
E1 --> C1 : membresíaVigente
C1 -> C1 : verificarEjecuciónVálidaDeJiuJitsu(video)
C1 -> C1 : detectarPracticantesEnEscenaInicial(video)
C1 --> B1 : siluetasDetectadas(candidatos)
B1 --> AL : solicitarConfirmaciónDePracticante(candidatos)
AL -> B1 : confirmarIdentidadEnEscena(practicanteSeleccionado)
B1 -> C1 : ejecutarAnálisisBiomecánico(alumno, profesor, técnica, video, practicanteSeleccionado)
C1 -> E3 : registrarEvaluaciónEnCurso(alumno, profesor, técnica)
E3 --> C1 : evaluaciónRegistrada
C1 -> C1 : extraerSecuenciaPostural(video, practicanteSeleccionado)
C1 -> E2 : obtenerPatrónDeReferencia(técnica, profesor)
E2 --> C1 : secuenciaDeReferencia
C1 -> C1 : compararPosturasYCalcularSimilitud(secuenciaAlumno, secuenciaDeReferencia)
C1 -> C1 : identificarFotogramaCríticoYArticulaciones()
C1 -> E3 : guardarDiagnósticoCinemático(similitud, fotogramaCrítico, articulaciones)
E3 --> C1 : evaluaciónActualizada
C1 --> B1 : análisisCinemáticoCompletado(evaluaciónActualizada)
B1 --> AL : presentarResultadoCinemático(similitud, fotogramaCrítico, articulaciones)
@enduml
