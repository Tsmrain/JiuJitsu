@startuml
left to right direction
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Alumno" as AL
actor "Base de Conocimiento\nTécnica" as BCT
actor "Servicio de Redacción\nPedagógica" as SRP

rectangle "Sistema Corpo e Mente - Feedback Pedagógico Biomecánico" {
    usecase "UC-04: Generar Feedback\nBiomecánico" as UC04
    usecase "Aplicar Jerarquía Estricta\nde Fuentes Doctrinales" as UC04_Jer
    usecase "Consultar Conocimiento\nTécnico de Referencia" as UC04_Con
    usecase "Elaborar Corrección\nen Idioma del Alumno" as UC04_Corr
    usecase "Auditar Fidelidad Pedagógica\ndel Consejo" as UC04_Aud
    usecase "Presentar Reporte con\nFotograma Crítico Anotado" as UC04_Rep
    usecase "Emitir Reconocimiento de\nEjecución Satisfactoria" as UC04_Ok
    usecase "Activar Respaldo Cuantitativo\nSeguro sin Alucinación" as UC04_Fall
}

AL --> UC04
UC04 ..> UC04_Jer : <<include>>
UC04 ..> UC04_Con : <<include>>
UC04 ..> UC04_Corr : <<include>>
UC04_Corr ..> UC04_Aud : <<include>>
UC04 ..> UC04_Rep : <<include>>
UC04 ..> UC04_Ok : <<extend>>\n(Similitud >= 85%)
UC04_Aud ..> UC04_Fall : <<extend>>\n(Sin Evidencia o Fidelidad < 0.85)

UC04_Con --> BCT
UC04_Corr --> SRP
UC04_Aud --> SRP
@enduml
