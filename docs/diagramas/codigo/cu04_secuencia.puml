@startuml
title Diagrama de Secuencia de Análisis (ECB) — UC-04: Generar Feedback Biomecánico
autonumber
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Alumno" as AL
boundary "PantallaDeResultados" as B1
control "CoordinadorDeFeedbackPedagógico" as C1
entity "Evaluación" as E1
entity "Técnica" as E2
entity "BibliotecaTécnica" as E3

AL -> B1 : solicitarReporteDeDiagnóstico(evaluación, idiomaPreferido)
B1 -> C1 : generarFeedbackBiomecánico(evaluación, idiomaPreferido)
C1 -> E1 : obtenerDiagnósticoCinemático(evaluación)
E1 --> C1 : similitud, fotogramaCrítico, articulacionesAfectadas

alt Similitud >= 85% (Ejecución Satisfactoria)
    C1 -> C1 : elaborarReconocimientoDeDominio(idiomaPreferido)
else Similitud < 85% (Requiere Corrección Pedagógica)
    C1 -> E3 : consultarPasajesEIlustracionesRelevantes(técnica, articulacionesAfectadas)
    E3 --> C1 : pasajesBibliográficosYRelevancia
    C1 -> E2 : obtenerDirectrizDelInstructor(técnica)
    E2 --> C1 : directrizDelInstructor
    C1 -> C1 : aplicarJerarquíaDeContexto(pasajes, directrizDelInstructor)
    alt Existe respaldo en Biblioteca o Directriz del Instructor
        C1 -> C1 : redactarCorrecciónEnIdioma(fotogramaCrítico, contextoPrioritario, idiomaPreferido)
        C1 -> C1 : auditarFidelidadFrenteAFuentes(corrección, contextoPrioritario)
    else Sin evidencia suficiente o baja fidelidad
        C1 -> C1 : activarRespaldoCuantitativoSeguro(idiomaPreferido)
    end
end

C1 -> C1 : anotarFotogramaCrítico(evaluación, articulacionesAfectadas)
C1 -> E1 : actualizarReporteFinal(evaluación, diagnósticoPedagógico, fotogramaAnotado)
E1 --> C1 : reporteFinalConfirmado
C1 --> B1 : feedbackListo(similitud, diagnósticoPedagógico, fotogramaAnotado)
B1 --> AL : presentarCorrecciónYCitasBibliográficas(diagnósticoPedagógico, fotogramaAnotado)
@enduml
