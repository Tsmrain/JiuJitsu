sequenceDiagram
    autonumber
    actor AL as Alumno
    participant B1 as «Boundary» UI Resultados
    participant B2 as «Boundary» UI Biblioteca Técnica
    participant C1 as «Control» Controlador de Retroalimentación
    participant C2 as «Control» Controlador de Conocimiento
    participant E1 as «Entity» Evaluación
    participant E2 as «Entity» Técnica
    participant E3 as «Entity» Manual Técnico
    participant E4 as «Entity» Nota del Profesor

    AL->>B1: consultarResultadoEnIdioma(evaluacion, idioma)
    B1->>C1: elaborarRetroalimentacion(evaluacion, idioma)
    C1->>E1: obtenerSimilitudYFrameLimpio(evaluacion)
    E1-->>C1: similitud, frameLimpio, articulaciones
    alt Similitud >= 85%
        C1-->>B1: emitirFelicitacionEnIdioma(idioma)
    else Similitud < 85%
        C1->>C2: buscarSustentoTecnico(tecnica, articulaciones)
        C2->>E3: recuperarPasajesRelevantes(tecnica)
        E3-->>C2: pasajesManual
        C2->>E4: obtenerNotaPractica(tecnica)
        E4-->>C2: notaProfesor
        C2-->>C1: contextoDisponible
        C1->>C1: sintetizarGuiaContextual(frameLimpio, contextoDisponible, idioma)
        opt Existen fuentes de referencia
            C1->>C1: auditarFidelidadSinInvenciones()
        end
        C1->>C1: higienizarTerminosRigidosYPaginas()
        C1->>E1: guardarDiagnosticoFinal()
        C1-->>B1: presentarComparativaYGuia()
        B1-->>AL: mostrarVideosSegundoCriticoYConsejo()
        opt Alumno consulta fuentes
            AL->>B2: abrirBibliotecaDeTecnica()
            B2-->>AL: mostrarCitasDiferenciadas()
        end
    end
