@startuml
left to right direction
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam BoundaryBorderColor #2B6CB0
skinparam BoundaryBackgroundColor #EBF8FF
skinparam ControlBorderColor #2F855A
skinparam ControlBackgroundColor #F0FFF4
skinparam EntityBorderColor #D69E2E
skinparam EntityBackgroundColor #FFFFF0
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC

actor "Administrador" as AD
actor "Usuario Asistido" as UA

rectangle "Sistema Corpo e Mente - Soporte Técnico" {
    usecase "UC-10: Entrar como Otro Usuario\n(Impersonificación de Soporte)" as UC10
    usecase "Reconfirmar Autorización\ndel Administrador" as UC10_Auth
    usecase "Registrar Constancia de\nAsistencia Técnica" as UC10_Audit
    usecase "Establecer Sesión Temporal\nde Diagnóstico" as UC10_Ses
    usecase "Mantener Aviso Visible\nde Modo Soporte" as UC10_Aviso
    usecase "Restituir Sesión Original\ndel Administrador" as UC10_Restore
}

AD --> UC10
UC10 --> UA
UC10 ..> UC10_Auth : <<include>>
UC10 ..> UC10_Audit : <<include>>
UC10 ..> UC10_Ses : <<include>>
UC10 ..> UC10_Aviso : <<include>>
AD --> UC10_Restore
@enduml
