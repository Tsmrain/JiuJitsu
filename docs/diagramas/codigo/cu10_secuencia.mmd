sequenceDiagram
    autonumber
    actor AD as Dueño
    participant B1 as «Boundary» UI Gestión de Sucursales
    participant C1 as «Control» Controlador de Sucursales
    participant E1 as «Entity» Sucursal
    participant E2 as «Entity» Usuario

    alt Registrar o actualizar sede
        AD->>B1: ubicarSedeEnMapaOEnlace(ubicacion)
        B1->>C1: interpretarUbicacionGeografica(ubicacion)
        C1-->>B1: propuestaPaisCiudadDireccion()
        AD->>B1: confirmarDatosDeSucursal(nombre, direccion, coordenadas)
        B1->>C1: guardarSucursal(datos)
        C1->>E1: registrarOActualizarSede(datos)
        E1-->>C1: sedeGuardada
        C1-->>B1: actualizarMapaYDirectorio()
    else Retirar sucursal inactiva
        AD->>B1: solicitarEliminarSucursal(sucursal)
        B1->>C1: verificarYEliminarSede(sucursal)
        C1->>E2: comprobarCuentasVinculadas(sucursal)
        alt Existen usuarios vinculados
            E2-->>C1: cuentasExistentes
            C1-->>B1: impedirBajaPorIntegridad()
        else Sin cuentas vinculadas
            C1->>E1: suprimirSucursal(sucursal)
            C1-->>B1: confirmarBajaDeSede()
        end
    end
