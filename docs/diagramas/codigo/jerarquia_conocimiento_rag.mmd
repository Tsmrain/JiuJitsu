flowchart TD
    classDef paso fill:#F7FAFC,stroke:#2B6CB0,color:#1A365D,stroke-width:1.5px
    classDef decision fill:#FFF5F5,stroke:#C53030,color:#742A2A,stroke-width:2px
    classDef salida fill:#F0FFF4,stroke:#2F855A,color:#22543D,stroke-width:2px

    INI["Diagnóstico Biomecánico: Similitud y Articulaciones Críticas"]:::paso
    D1{"¿Similitud >= 85%?"}:::decision
    FEL["Reconocimiento directo en idioma del alumno"]:::salida
    BUS["Búsqueda híbrida sobre manuales de técnica y biblioteca global"]:::paso
    D2{"¿Manual pertinente >= 0.65?"}:::decision
    P1["Prioridad 1: Síntesis contextual con manual + fotograma limpio"]:::paso
    D3{"¿Existe nota del profesor?"}:::decision
    P2["Prioridad 2: Síntesis natural basada en nota docente + fotograma limpio"]:::paso
    P3["Prioridad 3: Análisis visual directo del fotograma limpio y articulaciones"]:::paso
    JUEZ{"Juez de Fidelidad (si hay fuentes): ¿>= 0.85?"}:::decision
    RES["Respaldo determinístico seguro"]:::salida
    FIN["Corrección humana en segunda persona (citas 📚/🥋 en Biblioteca)"]:::salida

    INI --> D1
    D1 -->|"Sí"| FEL
    D1 -->|"No"| BUS --> D2
    D2 -->|"Sí"| P1 --> JUEZ
    D2 -->|"No"| D3
    D3 -->|"Sí"| P2 --> JUEZ
    D3 -->|"No"| P3 --> FIN
    JUEZ -->|"Aprobado"| FIN
    JUEZ -->|"Rechazado"| RES
