flowchart TD
    classDef paso fill:#F7FAFC,stroke:#2B6CB0,color:#1A365D
    classDef decision fill:#FFF5F5,stroke:#C53030,color:#742A2A
    classDef exito fill:#F0FFF4,stroke:#2F855A,color:#22543D

    subgraph L_Alumno["Alumno"]
        A1["Iniciar sesión y validar rol asignado"]:::paso
        A2["Elegir técnica y enviar video de práctica"]:::paso
        A3["Confirmar su silueta en la escena inicial"]:::paso
        A4{"¿Desea cancelar?"}:::decision
        A5["Volver al inicio sin registrar"]:::paso
        A6["Revisar comparativa, segundo del error y guía"]:::exito
    end

    subgraph L_Control["Control de Mensualidad"]
        C1{"¿Mensualidad vigente y práctica válida?"}:::decision
        C2["Informar restricción o rechazo"]:::decision
        C3["Registrar evaluación en curso en sede"]:::paso
        C4["Anular evaluación y limpiar archivo"]:::paso
    end

    subgraph L_Postura["Evaluación Postural"]
        P1["Detectar participantes iniciales"]:::paso
        P2["Seguir postura y comparar contra modelo"]:::paso
        P3["Calcular acierto y momento crítico"]:::paso
        P4["Extraer imagen del error y articulaciones"]:::paso
    end

    subgraph L_Guia["Conocimiento y Retroalimentación"]
        G1{"¿Ejecución sobresaliente?"}:::decision
        G2["Emitir felicitación en idioma del alumno"]:::exito
        G3["Consultar manuales de técnica y notas docentes"]:::paso
        G4["Redactar corrección práctica en lenguaje humano"]:::paso
        G5["Verificar respaldo en fuentes oficiales"]:::exito
    end

    A1 --> A2 --> C1
    C1 -->|"No"| C2
    C1 -->|"Sí"| P1 --> A3 --> C3
    C3 --> A4
    A4 -->|"Sí"| C4 --> A5
    A4 -->|"No"| P2 --> P3 --> P4 --> G1
    G1 -->|"Sí"| G2 --> A6
    G1 -->|"No"| G3 --> G4 --> G5 --> A6
