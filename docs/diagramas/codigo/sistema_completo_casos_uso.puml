@startuml Diagrama_Casos_Uso_Sistema_Completo
title Diagrama de Casos de Uso — Sistema Completo Corpo e Mente (UC-01 a UC-10)

left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 8
skinparam ArrowColor #2B6CB0
skinparam ActorBorderColor #C53030
skinparam ActorBackgroundColor #FFF5F5
skinparam UsecaseBorderColor #2B6CB0
skinparam UsecaseBackgroundColor #F7FAFC
skinparam PackageBorderColor #2F855A
skinparam PackageBackgroundColor #F0FFF4

actor "Alumno" as AL
actor "Profesor" as PR
actor "Administrador" as AD

actor "YOLOv26\n(Pose + Depth + Seg)" as YOLO
actor "Qwen3-VL\n(Embedding + Reranker + Instruct)" as QWEN
actor "Qdrant\nVector DB" as QDRANT
actor "PostgreSQL\n(RLS + pgcrypto)" as PG
actor "Cloudflare Tunnel" as CF
actor "Nominatim\n(OpenStreetMap)" as OSM

package "Subsistema de Identificación y Acceso (UC-01, UC-02)" as S1 {
  usecase "UC-01: Iniciar Sesión" as UC01
  usecase "Validar Credenciales\n(bcrypt + Rate Limit)" as UC01_VAL
  usecase "Emitir Token JWT\n(HS256, 24h)" as UC01_JWT
  usecase "UC-02: Registrar Nuevo Usuario" as UC02
  usecase "Validar Identificador Único\ny Seleccionar Sucursal" as UC02_VAL
  usecase "Inicializar Perfil y\nPase de Tatami Pendiente" as UC02_REG
}

package "Subsistema de Análisis y Feedback Biomecánico (UC-03, UC-04)" as S2 {
  usecase "UC-03: Analizar Técnica" as UC03
  usecase "Validar Video\n(Anti-SPAM ViCoS)" as UC03_SPAM
  usecase "Seleccionar Persona\nen Frame Inicial" as UC03_PERSONA
  usecase "Extraer Esqueleto 3D\n(x,y,z)" as UC03_POSE
  usecase "Calcular Similitud DTW\n(0-100%) y Frame Crítico" as UC03_DTW

  usecase "UC-04: Generar Feedback\nBiomecánico" as UC04
  usecase "Aplicar Jerarquía de Contexto\n(Manual > Profesor > Fallback)" as UC04_HIER
  usecase "Recuperar Teoría RAG\n(Two-Stage Híbrido)" as UC04_RAG
  usecase "Generar Corrección\nde IA (VLM Local)" as UC04_VLM
  usecase "Auditar Fidelidad\n(LLM-as-a-Judge >= 0.85)" as UC04_JUDGE
}

package "Subsistema de Gestión de Técnicas (UC-05)" as S3 {
  usecase "UC-05: Gestionar Técnicas\ny Videos de Referencia" as UC05
  usecase "Subir Video de Referencia\n(Patrón de Oro)" as UC05_VIDEO
  usecase "Extraer Esqueleto\nCanónico 3D" as UC05_YOLO
  usecase "Indexar Patrón\nen PostgreSQL + Qdrant" as UC05_INDEX
}

package "Subsistema de Conocimiento RAG (UC-06)" as S4 {
  usecase "UC-06: Gestionar Teoría RAG\ny Mensajes del Profesor" as UC06
  usecase "Escribir Directriz Directa\n(mensaje_profesor)" as UC06_MSG
  usecase "Cargar Manual PDF\n(Texto + Diagramas)" as UC06_PDF
  usecase "Vectorizar con Qwen3-VL\n(2048 dims)" as UC06_EMB
  usecase "Indexar en Qdrant\nColección rag_knowledge" as UC06_STORE
}

package "Subsistema de Progreso y Evaluaciones (UC-07)" as S5 {
  usecase "UC-07: Ver Progreso\nde Alumnos" as UC07
  usecase "Consultar Lista de\nAlumnos por Sucursal" as UC07_LIST
  usecase "Ver Historial\nde Evaluaciones" as UC07_HIST
  usecase "Reproducir Video con\nCorrección de IA" as UC07_PLAY
}

package "Subsistema de Pase de Tatami (UC-08)" as S6 {
  usecase "UC-08: Activar Pase\nde Tatami (30 Días)" as UC08
  usecase "Verificar Pago\nen Recepción" as UC08_PAY
  usecase "Calcular Fecha\nde Expiración (+30d)" as UC08_CALC
  usecase "Bloqueo Automático\nal Expirar" as UC08_BLOCK
}

package "Subsistema de Gestión de Sucursales (UC-09)" as S7 {
  usecase "UC-09: Gestionar Sucursales\ny Coordenadas Geográficas" as UC09
  usecase "Seleccionar Ubicación\nen Mapa Leaflet" as UC09_MAP
  usecase "Geocodificación\nInversa (Nominatim)" as UC09_GEO
  usecase "Guardar Coordenadas\n(lat, lng)" as UC09_SAVE
}

package "Subsistema de Soporte Técnico (UC-10)" as S8 {
  usecase "UC-10: Entrar como\nOtro Usuario" as UC10
  usecase "Reconfirmar Clave\nAdministrador" as UC10_AUTH
  usecase "Registrar Auditoría\n(deuda técnica)" as UC10_AUDIT
  usecase "Emitir JWT con\nimpersonator_admin_id" as UC10_JWT
  usecase "Activar Banner\nRojo de Soporte" as UC10_BANNER
  usecase "Restaurar Sesión\nOriginal" as UC10_RESTORE
}

AL --> UC01
PR --> UC01
AD --> UC01

AL --> UC02
PR --> UC02

AL --> UC03
AL --> UC04
AL --> UC07

PR --> UC05
PR --> UC06
PR --> UC07
PR --> UC08

AD --> UC05
AD --> UC08
AD --> UC09
AD --> UC10

UC01 ..> UC01_VAL : <<include>>
UC01 ..> UC01_JWT : <<include>>

UC02 ..> UC02_VAL : <<include>>
UC02 ..> UC02_REG : <<include>>
UC02 ..> UC01_JWT : <<include>>

UC03 ..> UC03_SPAM : <<include>>
UC03 ..> UC03_PERSONA : <<include>>
UC03 ..> UC03_POSE : <<include>>
UC03 ..> UC03_DTW : <<include>>
UC03 ..> UC04 : <<extend>>\n(Generar Feedback)

UC04 ..> UC04_HIER : <<include>>
UC04 ..> UC04_RAG : <<extend>>\n(Similitud < 85%)
UC04 ..> UC04_VLM : <<extend>>\n(Similitud < 85%)
UC04_VLM ..> UC04_JUDGE : <<include>>

UC05 ..> UC05_VIDEO : <<include>>
UC05_VIDEO ..> UC05_YOLO : <<include>>
UC05_YOLO ..> UC05_INDEX : <<include>>

UC06 ..> UC06_MSG : <<include>>
UC06 ..> UC06_PDF : <<include>>
UC06_PDF ..> UC06_EMB : <<include>>
UC06_EMB ..> UC06_STORE : <<include>>

UC07 ..> UC07_LIST : <<include>>
UC07 ..> UC07_HIST : <<include>>
UC07 ..> UC07_PLAY : <<extend>>

UC08 ..> UC08_PAY : <<include>>
UC08 ..> UC08_CALC : <<include>>
UC08 ..> UC08_BLOCK : <<extend>>

UC09 ..> UC09_MAP : <<include>>
UC09_MAP ..> UC09_GEO : <<include>>
UC09 ..> UC09_SAVE : <<include>>

UC10 ..> UC10_AUTH : <<include>>
UC10 ..> UC10_AUDIT : <<include>>
UC10 ..> UC10_JWT : <<include>>
UC10 ..> UC10_BANNER : <<include>>
AD --> UC10_RESTORE

UC03_SPAM --> YOLO
UC03_POSE --> YOLO
UC04_RAG --> QDRANT
UC04_VLM --> QWEN

UC05_YOLO --> YOLO
UC05_INDEX --> QDRANT
UC05_INDEX --> PG

UC06_EMB --> QWEN
UC06_STORE --> QDRANT

UC01_VAL --> PG
UC01_JWT --> PG
UC02_VAL --> PG
UC02_REG --> PG
UC07_LIST --> PG
UC07_HIST --> PG
UC08_CALC --> PG
UC09_GEO --> OSM
UC09_SAVE --> PG

AL ..> CF : HTTPS
PR ..> CF : HTTPS
AD ..> CF : HTTPS

@enduml
