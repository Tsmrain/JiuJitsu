classDiagram
    class PortalAcademico {
        <<Frontera>>
        +accesoYRegistro
        +evaluacionYResultados
        +catalogoYBiblioteca
        +mensualidadesYSucursales
        +presentarPantallaSegunPerfil
    }
    class GestorDeAcceso {
        <<Control>>
        +iniciarSesion
        +registrarAlumno
    }
    class GestorDeRoles {
        <<Control>>
        +validarRolYSucursal
        +administrarCuentasYSoporte
    }
    class GestorDeMensualidad {
        <<Control>>
        +validarMensualidad
        +activarMensualidadTreintaDias
    }
    class GestorDeEvaluacionYGuia {
        <<Control>>
        +compararContraPatron
        +generarRetroalimentacion
        +gestionarCatalogoYBiblioteca
    }
    class Usuario {
        <<Entidad>>
        +nombreCompleto
        +rolAsignado
        +idiomaPreferido
    }
    class Rol {
        <<Entidad>>
        +nombrePerfil
        +permisosAutorizados
    }
    class Sucursal {
        <<Entidad>>
        +nombreSede
        +ubicacionGeografica
    }
    class Mensualidad {
        <<Entidad>>
        +estadoVigencia
        +fechaVencimiento
    }
    class Tecnica {
        <<Entidad>>
        +nombreLegible
        +nivelCinturon
    }
    class Evaluacion {
        <<Entidad>>
        +porcentajeAcierto
        +segundoCritico
        +correccionEmitida
    }
    PortalAcademico --> GestorDeAcceso : acceso y registro
    PortalAcademico --> GestorDeRoles : perfil y cuentas
    PortalAcademico --> GestorDeMensualidad : vigencia mensual
    PortalAcademico --> GestorDeEvaluacionYGuia : práctica y guías
    GestorDeAcceso --> Usuario
    GestorDeRoles --> Usuario
    GestorDeRoles --> Rol
    GestorDeRoles --> Sucursal
    GestorDeMensualidad --> Mensualidad
    GestorDeEvaluacionYGuia --> Tecnica
    GestorDeEvaluacionYGuia --> Evaluacion
