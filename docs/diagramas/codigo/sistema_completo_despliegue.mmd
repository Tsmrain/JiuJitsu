flowchart TB
    classDef comp fill:#FFFFFF,stroke:#4A5568,color:#1A202C,stroke-width:1.5px
    classDef ext fill:#F0FFF4,stroke:#2F855A,color:#22543D,stroke-width:2px
    classDef db fill:#FFF5F5,stroke:#C53030,color:#742A2A,stroke-width:2px

    subgraph N_Cliente["Dispositivo del Usuario (Celular / Computadora)"]
        C_Web["Portal Web de la Academia"]:::comp
    end

    subgraph N_Externos["Servicios de Apoyo Externos"]
        E_Acceso["Canal Seguro de Acceso Remoto"]:::ext
        E_Mapas["Servicio Cartográfico de Ubicación"]:::ext
    end

    subgraph N_Academia["Estación Local en la Academia"]
        S_Portal["Atención de Solicitudes del Portal"]:::comp
        S_Reglas["Coordinación de Reglas de Negocio"]:::comp
        S_MotorIA["Evaluación Postural y Asistencia Técnica"]:::comp
        subgraph N_Repos["Resguardo Privado en Sede"]
            R_Datos["Registro Académico, Sedes y Mensualidades"]:::db
            R_Conoc["Acervo de Patrones, Manuales y Notas"]:::db
            R_Media["Archivo de Videos Modelo y Documentos"]:::db
        end
    end

    C_Web -->|"conexión segura"| E_Acceso
    C_Web -->|"consulta de mapas"| E_Mapas
    E_Acceso --> S_Portal
    S_Portal --> S_Reglas
    S_Reglas --> S_MotorIA
    S_Reglas --> R_Datos
    S_MotorIA --> R_Conoc
    S_Reglas --> R_Media
